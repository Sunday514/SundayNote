{
  "rollups": {
    "weekly_checkins": {
      "context": {
        "date": {
          "variable": "date"
        },
        "week": {
          "variable": "week"
        }
      },
      "source": {
        "type": "iso_week_days",
        "folder": "daily"
      },
      "extract": {
        "type": "checkbox_section",
        "heading": "打卡",
        "template": "daily_template"
      },
      "target": {
        "path": "{weekly}/{week}.md"
      },
      "block": {
        "start": "<!-- SN:weekly:auto:start -->",
        "end": "<!-- SN:weekly:auto:end -->"
      },
      "refresh_link": {
        "text": "刷新本周统计",
        "choice": "统计本周打卡",
        "param": "value-week",
        "value": "{week}"
      },
      "sections": ["table", "links"],
      "table": {
        "heading": "打卡统计"
      },
      "links": {
        "heading": "每日记录"
      }
    },
    "month_pack_checkins": {
      "required_context": ["weeks", "label"],
      "context": {
        "month": {
          "variable": "month",
          "infer_from_active_file": true,
          "active_folder": "monthly",
          "filename_patterns": [
            {
              "regex": "^(\\d{4})-(\\d{1,2})",
              "template": "{1}-{2:pad2}"
            },
            {
              "regex": "^(\\d{1,2})月记录$",
              "template": "{current_year}-{1:pad2}"
            }
          ],
          "default": "{current_month}"
        },
        "weeks": {
          "variable": "weeks",
          "from_month": "month",
          "week_rule": "sunday_in_month"
        },
        "label": {
          "variable": "label",
          "infer_from_active_file": true,
          "active_folder": "monthly",
          "default": "{month}",
          "prompt": false
        }
      },
      "source": {
        "type": "iso_weeks",
        "folder": "weekly"
      },
      "extract": {
        "type": "stats_table",
        "heading": "打卡统计"
      },
      "target": {
        "path": "{monthly}/{label}.md"
      },
      "block": {
        "start": "<!-- SN:month-pack:auto:start -->",
        "end": "<!-- SN:month-pack:auto:end -->"
      },
      "refresh_link": {
        "text": "刷新每月统计",
        "choice": "刷新每月统计",
        "param": "value-month",
        "value": "{month}"
      },
      "sections": ["links", "table"],
      "table": {
        "heading": "打卡统计"
      },
      "links": {
        "heading": "周记录"
      }
    }
  }
}
